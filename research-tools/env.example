# Optional environment overrides read by research-tools/env_paths.py.
# Copy values into your shell; nothing reads this file automatically.

# Node.js binary for REA. Default: first `node` on PATH (Node 22 verified on 2026-11-07).
# MPREA_NODE=C:\Program Files\nodejs\node.exe

# Original ardupilot-master.zip, only for verify-ardupilot-archive.py. Not in this repo.
# MPREA_ARDUPILOT_ZIP=C:\Users\think\OneDrive\Desktop\Projects\drone\ardupilot-master.zip

# Compiled LD_PRELOAD shim for SupportProxy loopback tests.
# Default: research-tools/supportproxy-loopback-bind.so (build from the .c file beside it; see env_paths.py).
# MPREA_SUPPORTPROXY_BIND_SHIM=C:\path\to\supportproxy-loopback-bind.so

# Directory holding the *-source-index.sqlite databases and their *-summary.json files (not in this repo).
# Default: ./integration-research if present, else ../integration-research.
# MPREA_INTEGRATION_DIR=C:\path\to\integration-research
